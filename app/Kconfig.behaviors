config ZMK_BEHAVIOR_INPUT_TWO_AXIS
    bool
    default y
    depends on DT_HAS_ZMK_BEHAVIOR_INPUT_TWO_AXIS_ENABLED && ZMK_POINTING

config ZMK_BEHAVIOR_SENSOR_ROTATE_COMMON
    bool

config ZMK_BEHAVIOR_SENSOR_ROTATE
    bool
    default y
    depends on DT_HAS_ZMK_BEHAVIOR_SENSOR_ROTATE_ENABLED
    select ZMK_BEHAVIOR_SENSOR_ROTATE_COMMON

config ZMK_BEHAVIOR_SENSOR_ROTATE_VAR
    bool
    default y
    depends on DT_HAS_ZMK_BEHAVIOR_SENSOR_ROTATE_VAR_ENABLED
    select ZMK_BEHAVIOR_SENSOR_ROTATE_COMMON

config ZMK_BEHAVIOR_STUDIO_UNLOCK
    bool
    default y
    depends on DT_HAS_ZMK_BEHAVIOR_STUDIO_UNLOCK_ENABLED && ZMK_STUDIO

config ZMK_BEHAVIOR_MACRO
    bool
    default y
    depends on DT_HAS_ZMK_BEHAVIOR_MACRO_ENABLED || DT_HAS_ZMK_BEHAVIOR_MACRO_ONE_PARAM_ENABLED || DT_HAS_ZMK_BEHAVIOR_MACRO_TWO_PARAM_ENABLED

config CONDUCTOR_OS_PROFILE
    bool "Conductor per-profile keymap overlay"
    default n
    help
      Assigns an overlay keymap layer to each output endpoint (USB / BLE
      profile). When an endpoint becomes the selected output the overlay layer
      is activated on top of the shared keymap (and the previous one
      deactivated), giving each device its own keymap where it differs while
      &trans positions inherit the shared layers. When disabled (or with every
      entry 0) the endpoint listener is inert and the keymap is unchanged.

config CONDUCTOR_OS_PROFILE_DEFAULT_ON
    bool "Per-profile keymap overlay enabled by default"
    default n
    depends on CONDUCTOR_OS_PROFILE
    help
      Initial runtime-enable state for the per-profile keymap overlay when no
      persisted setting exists. A value saved over the Studio RPC
      (set_os_config) overrides this default on subsequent boots. With the
      overlay map all-zero this has no effect on the keymap.

config CONDUCTOR_GESTURE_PROFILE
    bool "Conductor per-device trackball gesture overrides"
    default n
    help
      Adds a per-output-endpoint (USB / BLE profile) override table for the
      trackball gesture processor, so the same swipe can emit an OS-appropriate
      shortcut depending on which device is the current output. Configured over
      the Studio gesture RPC subsystem and persisted to settings. When disabled,
      or for any direction with no override set, the gesture processor uses the
      shared gesture layer (13) default exactly as before.

config CONDUCTOR_KEY_REPEAT
    bool "Conductor host-independent key auto-repeat (typematic)"
    default n
    help
      When enabled at runtime (via the Studio pointing RPC), the central
      synthesizes discrete release/press HID report pairs for the most recently
      pressed non-modifier keyboard-page key while it is held, after an initial
      delay and then at a fixed interval. This makes the host see repeated
      keypresses regardless of its own key-repeat settings (works around macOS
      press-and-hold suppressing letter repeat). Central-only. Ships disabled;
      the runtime enable/delay/interval are persisted by the pointing subsystem.

config CONDUCTOR_KEY_REPEAT_DELAY_MS
    int "Key auto-repeat initial delay (ms)"
    default 300
    depends on CONDUCTOR_KEY_REPEAT
    help
      Delay from key press to the first synthesized repeat. Used as the default
      when the persisted/runtime value is 0. Clamped to 100-2000 on apply.

config CONDUCTOR_KEY_REPEAT_INTERVAL_MS
    int "Key auto-repeat interval (ms)"
    default 40
    depends on CONDUCTOR_KEY_REPEAT
    help
      Interval between synthesized repeats after the initial delay. Used as the
      default when the persisted/runtime value is 0. Clamped to 10-200 on apply.
